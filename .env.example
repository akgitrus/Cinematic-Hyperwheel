HYPERWHEEL_DATA_DIR=./data/ml-latest
HYPERWHEEL_DATA_HOST_PATH=./data/ml-latest

# Backend (see apps/web/backend/app/config.py)
TMDB_API_KEY=
TMDB_BACKDROP_SIZE=w1280
TMDB_POSTER_SIZE=w185

# Signs issued proof-of-work challenges (see apps/web/backend/app/pow.py
# and apps/web/README.md, "Proof-of-work request gating"). Required for a
# stable multi-worker/production deployment; falls back to a random
# per-process secret otherwise.
POW_SECRET=

# Frontend - baked into the static bundle at BUILD TIME (see
# apps/web/frontend/vite.config.ts). VITE_ prefix required; anything
# else in this file is never exposed to client code.
VITE_GITHUB_URL=https://github.com/<your-org>/Cinematic-Hyperwheel
VITE_AUTHOR_URL=