{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Frontend",
            "type": "shell",
            "command": "npm run dev",
            "options": {
                "cwd": "${workspaceFolder}/apps/web/frontend"
            },
            "presentation": {
                "group": "dev-servers"
            }
        },
        {
            "label": "Run Backend",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/uvicorn app.main:app --reload --port 8000",
            "options": {
                "cwd": "${workspaceFolder}/apps/web/backend"
            },
            "presentation": {
                "group": "dev-servers"
            }
        },
        {
            "label": "Start Project (Full Stack)",
            "dependsOn": [
                "Run Frontend",
                "Run Backend"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}